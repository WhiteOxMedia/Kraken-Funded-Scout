#!/usr/bin/env bash
# VERSIONED (Sep 22): this file is tracked at hooks/pre-commit so the
# tripwire gate, the runtime-stash guard, and the CodeRabbit finding
# renderer survive fresh clones. A new checkout arms it with ONE line:
#   git config core.hooksPath hooks
# (.git/hooks copies are machine-local by git's design and will drift —
#  this tracked copy is the single source of truth.)
# ─────────────────────────────────────────────────────────────────────────
# PRE-COMMIT: CodeRabbit advisory review (user rule, Sep 7 — "wire cr
# review --agent into the pre-commit flow so changes get reviewed before
# landing").
#
# POLICY (user-chosen, Sep 7):
#   · WARN-ONLY — findings print, the commit is NEVER blocked by a review.
#   · FAIL-OPEN — if CodeRabbit is unavailable (signed out, offline, the
#     command hangs/errors), the commit proceeds and the reason is logged.
#
# WHY: kraken_scout is a LIVE TRADING system — the commit flow must never
# be hostage to a third-party CLI's auth state or uptime. The review is a
# second pair of eyes, not a gate. Use `git commit --no-verify` to skip
# entirely when you're in a hurry (the hook says so).
#
# WHAT IT REVIEWS: the staged content, reviewed in place. The repo churns
# live runtime state (logs, caches, ledgers, snapshots — see
# RUNTIME_INVARIANTS.md for the class list); the reviewer may see that
# churn in the working tree and it is noise, not danger. The review
# performs NO stash operations and never writes or moves a file: runtime
# state is owned exclusively by the running scanner.
#
# AUTH: `coderabbit auth login --api-key <key>` (an AGENTIC key from
# CodeRabbit settings — plain user keys are rejected by the CLI). The
# key is stored by CodeRabbit itself; the hook never handles it.
#
# ENV OVERRIDES:
#   CODERABBIT_OFF=1          skip the review entirely
#   CODERABBIT_TIMEOUT_SEC    review max seconds (default 300)
# ─────────────────────────────────────────────────────────────────────────
set -u

# Hoisted python resolution — used by the tripwire gate below AND the
# finding renderer at the bottom (absolute: blocks may cd into scratch dirs).
PY="$PWD/.venv/Scripts/python.exe"
[ -x "$PY" ] || PY="$(command -v python || command -v py || true)"

# ── PERMANENT GUARD (2026-09-21, RUNTIME_INVARIANTS.md): runtime state is
# never stashed. Any commit that ADDS stash logic is blocked here — except
# inside the enforcement layer itself (the guard suites and the safe-commit
# wrapper QUOTE the pattern in order to forbid it, mirroring the suite's
# own exemption; a real stash execution added there is still caught by
# test_no_runtime_stash's executable-line scan in the battery).
if git diff --cached -- . \
        ':(exclude)test_no_runtime_stash.py' \
        ':(exclude)test_hooks_ignore_runtime_state.py' \
        ':(exclude)safe_commit.py' \
        ':(exclude)runtime_tripwire.py' \
        ':(exclude)RUNTIME_INVARIANTS.md' 2>/dev/null | grep -qE '^\+.*git[[:space:]]+stash'; then
    echo "  ⛔ GUARD: added lines invoke a stash command — runtime state must" >&2
    echo "     never be stashed or auto-swept (see RUNTIME_INVARIANTS.md)." >&2
    echo "     Commit blocked. Remove the stash logic and retry." >&2
    exit 1
fi

# ── THE COMMIT GATE (Sep 22, generalized from the one-brain tripwire) ──
# Every staged change to a guarded source file runs that source's check
# drives against the STAGED content: the index exports into a scratch dir
# (never the worktree, never runtime state), drives run there with
# PYTHONPATH pointing back at the repo so non-staged imports resolve from
# HEAD. A failed verdict, a crash, or a budget overrun BLOCKS the commit
# — fail-closed everywhere, a missing verdict included. Per-drive budgets
# are sized ~5x the battery-measured runtime; -X utf8 matches the
# battery's own interpreter flag (the drives print unicode).
# Per-drive verdict contracts (verified 2026-09-22):
#   test_persistexit   check-file only (prints DONE; rc always 0)
#   test_autotrack     exit code + "N/M passed"
#   test_trailstop     exit code + "RESULT: N passed, M failed"
#   test_watchliveness exit code + RESULT (imports bs+ml: needs the
#                      scratch exports + PYTHONPATH)
#   test_metalayers    exit code + RESULT (censuses every guarded source)
# Measured cold runtimes (2026-09-22, HEAD): persistexit 0.4s, autotrack
# 0.7s, trailstop 0.4s, metalayers 2.9s, watchliveness 3.3s — the budgets
# below are ~5x those. Each drive runs at most ONCE per commit even when
# several guarded sources are staged together.
# Measured cold runtimes (2026-09-22, HEAD): persistexit 0.4s, autotrack
# 0.7s, trailstop 0.4s, metalayers 2.9s, watchliveness 3.3s — the budgets
# below are ~5x those. Each drive runs at most ONCE per commit even when
# several guarded sources are staged together.
# Emergency bypass stays available: git commit --no-verify — deliberately.
if git diff --cached --name-only | grep -qxE 'app\.py|background_scanner\.py|meta_layers\.py|profit_guard\.py'; then
    if [ -z "$PY" ]; then
        echo "  ⛔ GATE: guarded source staged but no python found — commit blocked." >&2
        exit 1
    fi
    SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/commitgate.XXXXXX")"
    trap 'rm -rf "$SCRATCH"' EXIT
    for src in app.py background_scanner.py meta_layers.py profit_guard.py; do
        git show ":$src" > "$SCRATCH/$src" 2>/dev/null || cp "$src" "$SCRATCH/$src" \
            || { echo "  ⛔ GATE: cannot stage $src for the gate" >&2; exit 1; }
    done
    # Windows Python cannot consume MSYS-style paths (/tmp, /c/...);
    # cygpath -w renders both PYTHONPATH entries natively: the scratch
    # (staged content) FIRST, the worktree as the fallback for modules
    # that were not staged (discipline, volatility_engine, ...).
    WINSCRATCH="$(cygpath -w "$SCRATCH" 2>/dev/null || echo "$SCRATCH")"
    WINREPO="$(cygpath -w "$PWD" 2>/dev/null || echo "$PWD")"
    export PYTHONPATH="$WINSCRATCH;$WINREPO"
    FAILS=""
    run_drive() {
        local t="$1" mode="$2" budget="$3"
        local out rc res failed p tot t0 t1 dt
        git show ":$t" > "$SCRATCH/$t" 2>/dev/null || cp "$t" "$SCRATCH/$t"
        t0="$(date +%s%N)"
        out="$(cd "$SCRATCH" && timeout "$budget" "$PY" -X utf8 "$t" 2>&1)"; rc=$?
        t1="$(date +%s%N)"; dt=$(( (t1 - t0) / 1000000 ))
        res=""; failed=""
        case "$mode" in
            checkfile)
                res="$(grep -oE 'RESULT: [0-9]+ passed, [0-9]+ failed' \
                           "$SCRATCH/_persist_check.txt" 2>/dev/null | tail -1)"
                failed="$(printf '%s' "$res" | sed -n 's/.*, \([0-9]*\) failed/\1/p')" ;;
            result)
                # two real conventions: "RESULT: N passed, M failed"
                # (persistexit-style) and the bare "N passed, M failed"
                # (trailstop, metalayers) — take the last verdict line
                res="$(printf '%s\n' "$out" | grep -oE '(RESULT: )?[0-9]+ passed, [0-9]+ failed' | tail -1)"
                failed="$(printf '%s' "$res" | sed -n 's/.*, \([0-9]*\) failed/\1/p')" ;;
            nm)
                res="$(printf '%s\n' "$out" | grep -oE '[0-9]+/[0-9]+ passed' | tail -1)"
                p="$(printf '%s' "$res" | sed -n 's/^\([0-9]*\)\/.*/\1/p')"
                tot="$(printf '%s' "$res" | sed -n 's|^[0-9]*/\([0-9]*\) passed.*|\1|p')"
                if [ -n "$p" ] && [ -n "$tot" ]; then failed=$(( tot - p )); fi ;;
        esac
        if [ "$rc" -eq 124 ]; then
            echo "  ⛔ GATE: $t exceeded its ${budget}s budget — blocked." >&2
            printf '%s\n' "$out" | tail -3 >&2
            FAILS="$FAILS $t(timeout)"
        elif [ "$rc" -ne 0 ] || [ -z "$res" ] || [ "${failed:-1}" != "0" ]; then
            echo "  ⛔ GATE: $t FAILED (${res:-no verdict — crashed or truncated}; rc=$rc)" >&2
            printf '%s\n' "$out" | tail -4 >&2
            FAILS="$FAILS $t"
        else
            echo "  🧠 gate: $t — $res (${dt}ms, budget ${budget}s)" >&2
        fi
    }
    _APP=no; _BS=no; _ML=no
    printf '%s\n' "$(git diff --cached --name-only)" | grep -qx 'app.py' && _APP=yes
    printf '%s\n' "$(git diff --cached --name-only)" | grep -qx 'background_scanner.py' && _BS=yes
    printf '%s\n' "$(git diff --cached --name-only)" | grep -qxE 'meta_layers\.py|profit_guard\.py' && _ML=yes
    # Trigger → drive map, deduped: when app.py AND background_scanner.py
    # are staged together (the f5ad99d shape), watchliveness and metalayers
    # would run twice under a naive per-source block — maybe_run keys on
    # the test name and runs each drive at most once per commit.
    RAN=""
    maybe_run() {
        local flag="$1" t; shift
        [ "$flag" = yes ] || return 0
        t="$1"
        case " $RAN " in *" $t "*) return 0 ;; esac
        RAN="$RAN $t"
        run_drive "$@"
    }
    maybe_run "$_APP" test_persistexit.py  checkfile 5
    maybe_run "$_APP" test_watchliveness.py result  20
    maybe_run "$_APP" test_metalayers.py   result   15
    maybe_run "$_BS"  test_autotrack.py    nm        5
    maybe_run "$_BS"  test_trailstop.py    result    5
    maybe_run "$_BS"  test_watchliveness.py result  20   # deduped when app.py also staged
    maybe_run "$_BS"  test_metalayers.py   result   15   # deduped
    maybe_run "$_ML"  test_metalayers.py   result   15   # deduped
    if [ -n "$FAILS" ]; then
        echo "  ⛔ COMMIT GATE: failed drives:${FAILS}" >&2
        echo "     Fix them (run the drive in the repo root) or bypass with" >&2
        echo "     git commit --no-verify — deliberately, never casually." >&2
        exit 1
    fi
    echo "  🧠 commit gate: every triggered drive green on the staged content." >&2
fi

[ "${CODERABBIT_OFF:-0}" = "1" ] && exit 0
[ -z "$(git diff --cached --name-only)" ] && exit 0   # nothing staged

BIN="$(command -v coderabbit || command -v cr || true)"
if [ -z "$BIN" ]; then
    echo "  🐇 CodeRabbit: CLI not found — skipping review (fail-open)." >&2
    echo "    hmm — 'coderabbit auth login' + restart the terminal to arm." >&2
    exit 0
fi

TIMEOUT="${CODERABBIT_TIMEOUT_SEC:-300}"

# Disabled: auto-stash of runtime state can hide live positions.
# (2026-09-21: the old dance reset the live watch ledger to empty twice,
# left a position unwatched mid-session, and its silent pop failure leaked
# 17 stashes. The review now runs against the tree as-is — runtime churn
# seen by the reviewer is noise. See RUNTIME_INVARIANTS.md.)
review_json="$(
  timeout "$TIMEOUT" "$BIN" review --agent --uncommitted 2>/dev/null | tr -d '\r'
)" 2>/dev/null
rc=$?

if [ $rc -ne 0 ]; then
    echo "  🐇 CodeRabbit: review didn't finish (rc=$rc; timeout ${TIMEOUT}s) — commit proceeds (fail-open)." >&2
    exit 0
fi

if [ -z "$review_json" ]; then
    echo "  🐇 CodeRabbit: no findings — clean review." >&2
    exit 0
fi

# Render the agent-mode findings. The REAL CLI shape (verified against
# the local review store, 2026-09-22): JSON records whose fields are
# fileName / startLine / severity / title / comment — the old sed looked
# for "file"/"line", matched nothing, and printed ?:? placeholders.
# This parser is field-tolerant (both key generations), handles JSONL,
# wrapped envelopes, and pretty-printed JSON, and NEVER swallows findings
# silently: if the stream carries text but nothing parses, the raw head
# is printed for eyes-on.
PYCODE="$(cat <<'CRPYEOF'
import sys, json

def walk(o, out):
    if isinstance(o, list):
        for i in o:
            walk(i, out)
    elif isinstance(o, dict):
        has_file = any(k in o for k in ("fileName", "file", "path"))
        has_body = any(k in o for k in ("severity", "title", "comment"))
        if has_file and has_body:
            out.append(o)
        else:
            for v in o.values():
                if isinstance(v, (list, dict)):
                    walk(v, out)

raw = sys.stdin.read().replace("\r", "")
records = []
try:
    walk(json.loads(raw), records)          # pretty-printed single JSON
except Exception:
    pass
if not records:
    buf = ""                                # JSONL, pretty or compact:
    for ln in raw.splitlines():             # accumulate to balanced braces
        buf += ln + "\n"
        if buf.count("{") <= buf.count("}"):
            try:
                walk(json.loads(buf), records)
            except Exception:
                pass
            buf = ""
    if buf.strip():
        try:
            walk(json.loads(buf), records)
        except Exception:
            pass
if not records:
    print("RAWFALLBACK")
    sys.exit(0)
n = 0
sevs = []
for o in records:
    f = o.get("fileName") or o.get("file") or o.get("path") or "?"
    l = o.get("startLine")
    if l is None:
        l = o.get("line")
    if l is None:
        lr = o.get("lineRange") or {}
        l = lr.get("start") if isinstance(lr, dict) else None
    if l is None:
        l = o.get("endLine") or "?"
    s = str(o.get("severity") or "?")
    # title fallbacks: null fields appear in the live stream even when
    # the local store later fills them — never print ? while any
    # descriptive text survives in the record
    t = (o.get("title") or o.get("comment") or o.get("type")
         or o.get("commentCategory") or "")
    if not t and o.get("indicatorTypes"):
        t = ", ".join(str(x) for x in o["indicatorTypes"])
    t = str(t).strip().splitlines()[0][:100] if str(t).strip() else "(no title text in stream)"
    n += 1
    sevs.append(s)
    print("- %s:%s [%s] %s" % (f, l, s, t))
print("COUNT %d" % n)
for s in sevs:
    print("SEV " + s)
CRPYEOF
)"
PARSER_OUT="$(printf '%s\n' "$review_json" | "$PY" -c "$PYCODE" 2>/dev/null)"
n="$(printf '%s\n' "$PARSER_OUT" | sed -n 's/^COUNT //p' | tail -1)"
sev="$(printf '%s\n' "$PARSER_OUT" | sed -n 's/^SEV //p' | tr '\n' ' ' | sed 's/ $//')"
if [ -z "$n" ]; then
    echo "  🐇 CodeRabbit findings (unparsed stream — eyes on, commit proceeds):" >&2
    printf '%s' "$review_json" | head -c 600 >&2
    echo >&2
    n=0
    sev=""
else
    echo "  🐇 CodeRabbit findings:" >&2
    printf '%s\n' "$PARSER_OUT" | grep '^-' | sed 's/^/    /' >&2
fi

echo "  🐇 CodeRabbit: $n finding(s). Advisory only — commit proceeds." >&2
echo "    (blockers seen:${sev:+ $sev})" >&2
echo "    skip anytime: git commit --no-verify" >&2
exit 0