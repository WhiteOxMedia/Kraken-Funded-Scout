# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Node dependencies for the devnet E2E suite (tests/xmrj_devnet_e2e.ts).
# package.json + package-lock.json ARE committed: the lockfile is what makes a
# fresh clone install the same client the workspace pins (Anchor.toml
# [toolchain] anchor_version / @anchor-lang/core), exactly as Cargo.lock will
# do for the crates once a build has produced one.
node_modules/

# Rust / Anchor build output. target/deploy/ holds the PROGRAM KEYPAIRS
# (target/deploy/<program>-keypair.json) — the private half of every program
# address in Anchor.toml. They are local identity material: never committed,
# and losing them loses the ability to upgrade at that address.
target/

# field_crypto at-rest encryption keys (NEVER commit)
.keys/
*.retired.*

# fleet telemetry: churns on every run, including inside commit gates
fleet_history.jsonl

# runtime state (RUNTIME_INVARIANTS idiom): the review-receipt ledger
# is live coverage state — never committed (a committed ledger would
# lie about coverage after a clone)
scratch/

# ── live state: preserved on disk, NEVER committed ────────────────────
# The pool's SQLite database is the running site's real state (accounts,
# tickets, drawings). A committed copy would be a stale snapshot that a
# clone could mistake for its own ledger, so it is local-only — but it is
# also never deleted by cleanup: the -wal/-shm sidecars belong to it.
pool/jackpot.db
pool/jackpot.db-wal
pool/jackpot.db-shm
pool/push_events.jsonl
.signal_runtime_state.json
.signal_runtime_state.json.tmp
.signal_runtime_watcher.instance.txt

# ── the review bundle: only the artifact and its checksum ship ────────
# dist_site_review/xmrjackpot_review/ is make_bundle.py's EXPANDED copy of
# pool/templates + pool/static (rebuilt wholesale every run), so committing
# it duplicates the sources and invites drift. The zip is the artifact and
# the .sha256 is how a reviewer verifies it. Oct 29: the checkout stopped
# TRACKING the binary artifact — it is rebuilt by make_bundle.py in one
# command, so a fresh clone regenerates it instead of importing a stale
# snapshot. The files stay on disk locally; only git forgets them.
dist_site_review/*

# ── installed toolchains, not vendored sources ────────────────────────
# monero/ (node + build tree), p2pool/ and xmrig/ are downloaded/installed
# locally (gigabytes); the repo ships the scripts that use them, not the
# binaries. setup_kraken.py / install.ps1 fetch what is missing.
monero/
p2pool/
xmrig/

# ── runtime logs and local-only workspaces ────────────────────────────
logs/
pool_server.log
pool_server.err.log
logs_server_restart.txt
.workshop/

# dated working plans: historical notes, kept locally, not part of the
# product a clone builds
plans/

# local audit workspace (scratch reports, one marker file)
auditors/

# ── probe / scratch output: one-off artefacts of a live investigation ──
# Every pattern here existed in the working tree at the launch cleanup and
# was deleted (curl dumps, probe scripts, pre-change database copies,
# stitched HTML). The rules are anchored to the repo root so a real source
# file one directory down cannot be swallowed by accident, and they are the
# reason the next investigation cannot re-enter the tree by habit.
/_*
/*_report*.txt
/*_scan*.txt
/*.log
/fix_*.py
/session.yml
/*_backup_*.db*
/*.bak

# the same debris when it lands next to the statics it probes
pool/static/_*
tools/_*
pool/static/*.new
pool/static/*.new.*
pool/static/*.checker.txt
pool/static/*.missing.txt
pool/static/*.report.txt
pool/static/session.yml
pool/jackpot.db.pre-*.bak
pool/_backup_*.db*

# smoke-probe output the readiness checklist reads back (run artifact, never shipped)
smoke_probe*
**/smoke_probe*

# relay deployment scratch: admin keypair, downloaded tools, session logs.
# The private key must never be committed.
.relay/

# fleet timing artifacts (run telemetry, churns every run — never shipped.
# .archive.jsonl is the rotated ledger run_fleet.py writes past 200 runs)
fleet_timings.json
fleet_timings.jsonl
fleet_timings.archive.jsonl
fleet_timings.json.tmp
