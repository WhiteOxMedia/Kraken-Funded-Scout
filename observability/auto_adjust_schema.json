{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "auto_adjust event (task 4, Sep 28 spec)",
  "type": "object",
  "required": ["event", "rotation_id", "before_gf", "after_gf", "delta",
               "B", "P", "r", "evidence_checksum", "commit_sha",
               "cohort", "applied_by", "timestamp"],
  "properties": {
    "event": {"const": "auto_adjust"},
    "rotation_id": {"type": "string",
                    "description": "the scanner's 4h window stamp, e.g. 2026-09-28-16-20"},
    "before_gf": {"type": "number",
                  "description": "guard factor before the adjustment"},
    "after_gf": {"type": "number", "description": "guard factor after"},
    "delta": {"type": "number",
              "description": "negative = loosened; 0 for queue/revert rows"},
    "B": {"type": "integer", "minimum": 0,
          "description": "measurable buried candidates in the rotation"},
    "P": {"type": "integer", "minimum": 0,
          "description": "of those, the ones that reached the goal"},
    "r": {"type": ["number", "null"],
          "description": "P/B payer-rate; null when B=0"},
    "per_gate": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "B_g", "P_g", "r_g"],
        "properties": {
          "gate": {"type": "string"},
          "B_g": {"type": "integer"},
          "P_g": {"type": "integer"},
          "r_g": {"type": ["number", "null"]}
        }
      }
    },
    "evidence_checksum": {"type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit_sha": {"type": "string",
                   "description": "short HEAD sha the adjustment ran under"},
    "cohort": {"type": "string",
               "description": "canary cohort id, 'full' after sign-off"},
    "applied_by": {"type": "string",
                   "description": "'system', 'operator', or the named operator id — a named operator is legitimate telemetry, not a schema violation"},
    "timestamp": {"type": "string", "format": "date-time"},
    "expires_after_rotations": {"type": "integer", "minimum": 1},
    "status": {"enum": ["applied", "queued", "refused", "reverted"]},
    "reason": {"type": "string"}
  }
}
