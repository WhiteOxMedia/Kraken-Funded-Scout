@echo off
rem vrsc-relay.cmd — the Verus relay's guarded entry point on the pool PC.
rem REGENERATED by `python relay/up-vrsc.py` on every run (port/upstream/db live
rem there; this file only holds them baked in). Launched at logon from
rem Startup (up-vrsc.py copies it there) and started detached on demand.
rem
rem GUARD: only one copy may hold the port. run.md's lesson applies here too —
rem a zombie python can be ALIVE with its LISTENING socket gone, so the check
rem is on the LISTENING line, not on a pid.
cd /d "C:\Users\birds\Workspace\monero_project"
if not exist ".relay\logs" mkdir ".relay\logs"
netstat -ano | findstr ":3957 " | findstr "LISTENING" >nul 2>&1
if %errorlevel%==0 (
  echo vrsc relay already LISTENING on 3957 — not starting a second copy.
  exit /b 0
)
echo [%date% %time%] vrsc relay starting >> ".relay\logs\vrsc-relay.log"
python pool\vrsc_relay.py --listen-port 3957 --stratum "na.luckpool.net:3956" --db pool\jackpot.db >> ".relay\logs\vrsc-relay.log" 2>&1
