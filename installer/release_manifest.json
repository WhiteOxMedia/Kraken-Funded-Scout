  "content_rules": [
    {
      "id": "database-credential",
      "pattern": "postgres(?:ql)?://[^\\s:@/]+:[^\\s@/]+@",
      "why": "a connection string with an embedded password"
    },
    {
      "id": "bearer-token",
      "pattern": "(?i)\\b(?:bearer|authorization)\\s*[:=]\\s*[\\\"']?(?:[A-Za-z0-9._~+/-]{20,})",
      "why": "a hard-coded bearer credential"
    },
    {
      "id": "api-key-literal",
      "pattern": "(?i)\\b(?:api[_-]?key|secret[_-]?key|access[_-]?token|operator[_-]?token|password)\\b\\s*[:=]\\s*[\\\"'][^\\\"'\\s]{8,}[\\\"']",
      "why": "a secret-looking literal in shipped code"
    },
    {
      "id": "operator-wallet",
      "pattern": "\\b[48][1-9A-HJ-NP-Za-km-z]{94,105}\\b",
      "why": "a Monero address baked into a customer artifact"
    },
    {
      "id": "developer-rig-id",
      "pattern": "Birdsnbubbles",
      "why": "the operator's xmrig rig id"
    },
    {
      "id": "localhost-pool",
      "pattern": "127\\.0\\.0\\.1:(?:3333|3334|9090|18082)",
      "why": "a developer-local pool/RPC endpoint"
    },
    {
      "id": "preprod-version",
      "pattern": "(?i)\\bpreprod\\b",
      "why": "a non-production version label"
    },
    {
      "id": "private-ntfy-topic",
      "pattern": "ntfy\\.sh/[A-Za-z0-9_-]{12,}",
      "why": "a private notification topic URL"
    }
  ]
}
