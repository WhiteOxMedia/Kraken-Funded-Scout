opp_hindsight_report.txt
# the tide-retune valve's persisted day ledger (a restart must not
# refill the daily cap) + its lock anchor (PERSISTS — only the
# kernel's byte-range on it is the lock; the file itself is just the
# handle's anchor and stays beside the ledger)
tide_retune_state.json
tide_retune_state.json.tmp*
tide_retune_state.json.lock
